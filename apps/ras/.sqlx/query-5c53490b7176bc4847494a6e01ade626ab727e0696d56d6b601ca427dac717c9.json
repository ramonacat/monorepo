  "query": "\n        SELECT \n            nc.name AS name,\n            ncs.current_store_path as current_closure,\n            ncs.updated_at as current_closure_updated_at\n        FROM nixos_closure_state ncs\n        INNER JOIN nixos_closure nc ON nc.id = ncs.closure_id\n        WHERE nc.name LIKE 'home:%'\n    ",
