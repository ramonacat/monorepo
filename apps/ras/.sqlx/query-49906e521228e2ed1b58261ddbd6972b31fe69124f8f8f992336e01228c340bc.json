{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            h.id,\n            h.name,\n            wh.addresses,\n            COALESCE((\n                SELECT array_agg(port)\n                FROM unnest(wh.ports) port\n                WHERE NOT EXISTS (SELECT 1 FROM wireguard_tunnel WHERE responder_id=h.id AND responder_port=port)\n            ), '{}') AS \"ports!\"\n        FROM host h\n        INNER JOIN wireguard_host wh ON wh.host_id=h.id\n        WHERE h.id=$1\n    ",
