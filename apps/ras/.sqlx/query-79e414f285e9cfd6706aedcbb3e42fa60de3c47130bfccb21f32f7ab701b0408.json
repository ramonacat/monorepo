  "query": "\n        SELECT \n            rr.id, \n            rr.target_ips,\n            rr.target_cidr,\n            rr.blackhole,\n            h.name AS hostname \n        FROM routing_route rr \n        INNER JOIN host h ON h.id=rr.target_host_id\n    ",
