{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "kubernetes": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "maxMajorIncrement": 0,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["*"],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies - js",
      "groupSlug": "all-minor-patch-js"
    },
    {
      "matchDatasources": ["crate"],
      "matchPackageNames": ["kube", "k8s-openapi", "gateway-api"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "kube and related",
      "groupSlug": "kubers-plus"
    },
    {
      "matchDatasources": ["!npm"],
      "matchPackageNames": ["!python"],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ]
}
